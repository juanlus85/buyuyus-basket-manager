# Copiar a .env en el VPS y reemplazar todos los valores por secretos reales.
# Nunca subir este archivo con valores reales al repositorio.

NODE_ENV=production
DATABASE_URL=mysql://USUARIO:CONTRASENA@127.0.0.1:3306/buyuyus_basket
JWT_SECRET=GENERA_UN_SECRETO_LARGO_Y_ALEATORIO

# Identidad y autenticación configurada para esta versión.
OAUTH_SERVER_URL=URL_DEL_PROVEEDOR_OAUTH
VITE_APP_ID=ID_DE_LA_APLICACION_OAUTH
VITE_OAUTH_PORTAL_URL=URL_DEL_PORTAL_DE_ACCESO
OWNER_OPEN_ID=IDENTIFICADOR_DEL_ADMINISTRADOR_PRINCIPAL
OWNER_NAME=Nombre del administrador

# Almacenamiento en el VPS: no requiere credenciales Forge.
# Por defecto los archivos se guardan en ./storage/uploads (fuera de dist/public).
# Define una ruta absoluta solo si Plesk necesita una ubicación escribible distinta.
# FILE_STORAGE_DIR=/ruta/privada/escribible/buyuyus-uploads

# Opcionales: servicios Manus/Forge para funciones adicionales del entorno WebDev.
# No son necesarios para importar PDFs, subir fotos o publicar documentos en el VPS.
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
# VITE_FRONTEND_FORGE_API_URL=
# VITE_FRONTEND_FORGE_API_KEY=

# Opcionales: analítica de la aplicación.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
